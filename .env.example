# Local PostgreSQL. Change these values for any shared or production environment.
DATABASE_URL="postgresql://wamoro:wamoro_dev@localhost:5433/wamoro_farms?schema=public"

# Generate a unique 32+ character secret with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Required by `npm run db:seed`; set an owner-managed address and strong password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-strong-password"
ADMIN_NAME="Wamoro Farms Admin"

# Persistent disk path for media uploads in production. Back it up with the database.
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"

# Optional canonical URL used in metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
